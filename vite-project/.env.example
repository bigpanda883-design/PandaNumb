# -----------------------------------------------------------------------------
# Panda Numbers - SERVER environment TEMPLATE
# -----------------------------------------------------------------------------
# Copy this to `.env.server` and fill in the real values.
# `.env.server` is gitignored - never commit the real key.

# Yankee Verify API key (server-side only; never exposed to the browser).
# REQUIRED. While this is empty every /api/sms request answers 503 and the app
# shows "Number purchases are temporarily unavailable" - that means the key is
# missing, not that the provider is down. Get the key from your Yankee Verify
# dashboard. Check GET /api/sms/health (keyConfigured) to confirm it loaded.
# Prefer the canonical name below. The legacy YANKEE_VERIFY_API_KEY name is still accepted.
YANKEE_API_KEY=
# YANKEE_VERIFY_API_KEY=

# Optional overrides
# YANKEE_API_BASE_URL=https://yankee-verify-api.onrender.com/api/v1/handler_api.php
# YANKEE_VERIFY_BASE_URL=https://yankee-verify-api.onrender.com/api/v1/handler_api.php
# PORT=8787

# Auth and email configuration
# Panda Number sends verification, welcome, login and password-reset emails
# through Gmail SMTP. SMTP_USER must be authorized to send from MAIL_FROM.
# SMTP. SMTP_PASS is a Google App Password (not the Gmail password): enable
# 2-Step Verification, then generate one at https://myaccount.google.com/apppasswords.
# These live on the server only - never in the React app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=pandanumbersms@gmail.com
# SMTP_PASS=your_google_app_password
# MAIL_FROM="Panda Number <pandanumbersms@gmail.com>"
# PASSWORD_RESET_TTL_MINUTES=10
#
# Legacy names (still honoured): EMAIL_HOST / EMAIL_PORT / EMAIL_USER /
# EMAIL_PASSWORD / EMAIL_FROM / EMAIL_SECURE.

# -----------------------------------------------------------------------------
# Frontend environment (client-visible - NEVER put secrets here)
# -----------------------------------------------------------------------------
# Base URL of your own backend (the Express app in server/index.js).
#
# In DEVELOPMENT leave it unset: the Vite proxy forwards /api to
# http://127.0.0.1:8787, so same-origin just works.
#
# In PRODUCTION it is REQUIRED and must be the deployed backend, e.g.
#   VITE_API_BASE_URL=https://pandanumbers-api.onrender.com
# If it is unset, the browser calls https://<your-vercel-app>/api/auth/login -
# the STATIC frontend host, which has no Express routes. Login, signup and
# forgot-password then fail on the deployed site while still working on the
# laptop. Vite inlines this at BUILD time, so changing it needs a redeploy.
# A wrong value is reported in the UI as "This app is not connected to its
# server", and https://<backend>/api/health tells you whether it is up (it also
# returns dbOk / accounts / persistentStorage).
# VITE_API_URL=https://<your-service>.onrender.com
# VITE_API_BASE_URL=https://<your-service>.onrender.com
# VITE_SMS_API_BASE=/api/sms
# VITE_SMS_POLL_INTERVAL=5000
# -----------------------------------------------------------------------------
# Backend environment (Render) - SERVER side only, never sent to the browser
# -----------------------------------------------------------------------------
# Persistent storage for the SQLite database. Render's filesystem is EPHEMERAL:
# without a disk the database is recreated empty on every deploy/restart, so the
# account created yesterday no longer exists. Create a Render Disk mounted at
# e.g. /var/data and set DATA_DIR=/var/data (see /api/health -> persistentStorage).
# DATA_DIR=/var/data
#
# Comma-separated browser origins allowed to call the API. Vercel preview hosts
# are matched by wildcard. Anything else is refused with 403 ORIGIN_NOT_ALLOWED,
# so a mis-pointed frontend fails loudly instead of appearing to work. The
# effective list is printed in the Render log at startup.
# FRONTEND_ORIGINS=https://pandanumbers.vercel.app,https://*.vercel.app,http://localhost:5173

# -----------------------------------------------------------------------------
# Wallet funding - Flutterwave virtual bank accounts (SERVER side only)
# -----------------------------------------------------------------------------
# A user's wallet is credited ONLY by a transfer into their Flutterwave virtual
# account, confirmed by Flutterwave's verify API. While either variable is
# missing, the deposit routes answer 503 PAYMENT_NOT_CONFIGURED and
# GET /api/payments/config names the missing one. Nothing is ever simulated.
#
# THE SECRET KEY IS NEVER IN THIS FILE, IN THE REPO OR IN THE FRONTEND.
# Set these in Render -> Environment (backend service only), then redeploy.
#
# Secret Key, from Flutterwave dashboard -> Settings -> API Keys.
#   Live keys start with FLWSECK-  ; test keys start with FLWSECK_TEST-
# The leading prefix is how the server decides its mode: a test key can NEVER
# credit a live wallet, and a live key never touches a test account.
FLW_SECRET_KEY=

# Webhook secret hash, from Settings -> Webhooks. Flutterwave sends it back in
# the `verif-hash` header; a webhook without a matching hash is refused (401).
FLW_WEBHOOK_SECRET_HASH=

# NOT read by this backend: the public key and AES encryption key are only
# needed by browser-side card charging, which this wallet does not use. Leave
# them out of the backend environment unless a card flow is added later.
# FLW_PUBLIC_KEY=
# FLW_ENCRYPTION_KEY=

# Point Flutterwave's webhook at:
#   https://<your-render-service>/api/webhooks/flutterwave
#
# Deposit bounds, in naira (NGN virtual accounts only).
# MIN_DEPOSIT_NAIRA=100
# MAX_DEPOSIT_NAIRA=500000

# Token for POST /api/health/flutterwave/reconcile (re-verifies recorded but
# uncredited deposits). Leave unset to disable the endpoint entirely.
ADMIN_RECONCILE_TOKEN=

# Comma-separated backend-verified admin email allowlist for the read-only
# payment operations dashboard. Leave empty to disable admin access.
ADMIN_EMAILS=
