# -----------------------------------------------------------------------------
# Panda Numbers - SERVER environment TEMPLATE
# -----------------------------------------------------------------------------
# Copy this to `.env.server` and fill in the real values.
# `.env.server` is gitignored - never commit the real key.

# Yankee Verify API key (server-side only; never exposed to the browser).
YANKEE_VERIFY_API_KEY=your_provider_api_key_here

# Optional overrides
# YANKEE_VERIFY_BASE_URL=https://yankee-verify-api.onrender.com/api/v1/handler_api.php
# PORT=8787

# -----------------------------------------------------------------------------
# Frontend environment (client-visible - NEVER put secrets here)
# -----------------------------------------------------------------------------
# Base URL of your own backend that proxies the SMS provider.
# In development the Vite proxy handles /api, so this can stay unset.
# VITE_API_BASE_URL=http://localhost:8787