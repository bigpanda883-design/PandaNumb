# -----------------------------------------------------------------------------
# Panda Numbers - SERVER environment TEMPLATE
# -----------------------------------------------------------------------------
# Copy this to `.env.server` and fill in the real values.
# `.env.server` is gitignored - never commit the real key.

# Yankee Verify API key (server-side only; never exposed to the browser).
# REQUIRED. While this is empty every /api/sms request answers 503 and the app
# shows "Number purchases are temporarily unavailable" - that means the key is
# missing, not that the provider is down. Get the key from your Yankee Verify
# dashboard. Check GET /api/sms/health (keyConfigured) to confirm it loaded.
# Prefer the canonical name below. The legacy YANKEE_VERIFY_API_KEY name is still accepted.
YANKEE_API_KEY=
# YANKEE_VERIFY_API_KEY=

# Optional overrides
# YANKEE_API_BASE_URL=https://yankee-verify-api.onrender.com/api/v1/handler_api.php
# YANKEE_VERIFY_BASE_URL=https://yankee-verify-api.onrender.com/api/v1/handler_api.php
# PORT=8787

# Auth and email configuration
# Panda Number sends login notifications and password-reset codes through Gmail
# SMTP. SMTP_PASS is a Google App Password (not the Gmail password): enable
# 2-Step Verification, then generate one at https://myaccount.google.com/apppasswords.
# These live on the server only - never in the React app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=pandanumb001@gmail.com
# SMTP_PASS=your_google_app_password
# MAIL_FROM="Panda Number <pandanumb001@gmail.com>"
# PASSWORD_RESET_TTL_MINUTES=10
#
# Legacy names (still honoured): EMAIL_HOST / EMAIL_PORT / EMAIL_USER /
# EMAIL_PASSWORD / EMAIL_FROM / EMAIL_SECURE.

# -----------------------------------------------------------------------------
# Frontend environment (client-visible - NEVER put secrets here)
# -----------------------------------------------------------------------------
# Base URL of your own backend that proxies the SMS provider.
# In development the Vite proxy handles /api, so this can stay unset.
# VITE_API_BASE_URL=http://localhost:8787
# VITE_SMS_API_BASE=/api/sms
# VITE_SMS_POLL_INTERVAL=5000