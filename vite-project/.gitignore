# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# -----------------------------------------------------------------------------
# Secrets - NEVER commit these
# -----------------------------------------------------------------------------
# .env.server holds the Yankee Verify API key. Committing it would leak the key.
.env
.env.*
!.env.example
# Public build config (the API URL the browser calls). NOT a secret - it must
# ship with the repo so a Vercel build never forgets to point at the backend.
!.env.production

# Belt-and-braces: block the key file even if a broad pattern is loosened later.
*.key
server/.env*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
